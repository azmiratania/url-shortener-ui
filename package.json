{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL shortener service: shortens long URLs into unique slugs and redirects via 302.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"tsx watch src/index.ts\" \"vite build --watch\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:ui": "vite",
    "start": "tsx src/index.ts",
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests frontend/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:types": "openapi-typescript specs/openapi.yaml -o src/generated/api-types.ts"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
